{
	// Game server: one Durable Object ("TableRoom") per mahjong table.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jade-table-server",
	"main": "src/cloudflare.ts",
	"compatibility_date": "2026-06-01",
	"durable_objects": {
		"bindings": [{ "name": "TABLES", "class_name": "TableRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["TableRoom"] }],
	"observability": { "enabled": true }
}
